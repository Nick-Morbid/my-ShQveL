# Copy to experiment.env and adjust only non-secret experiment settings.
EXPERIMENT_HOURS=24
EPOCH_SECONDS=3600
PG_VERSION=18.3
PG_PORT=55433
PG_DATABASE=shqvel
PG_USER=postgres
PG_PASSWORD=shqvel-cov-local
PG_SOURCE=/app/my_ShQveL/postgres/source/postgresql-18.3
PG_INSTALL=/app/my_ShQveL/postgres/install/postgres183-cov
PG_DATA=/app/my_ShQveL/postgres/data
PG_SOCKET=/app/my_ShQveL/postgres/socket
SHQVEL_REPO=/tmp/SQLancerPlusPlus
CONDA_ENV=shqvel
NFS_ROOT=/app/nfs/chq_data/ShQveL/postgres
LOCAL_ROOT=/app/my_ShQveL
LCOV_BRANCH_RC=lcov_branch_coverage=1
